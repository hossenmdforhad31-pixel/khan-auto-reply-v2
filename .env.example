# Copy these names into your hosting provider's environment variable settings.
# NEVER commit real values to Git.

# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# Telethon StringSession for YOUR account (create it with generate_session.py)
SESSION=your_string_session_here

# Shown to customers after they confirm a purchase
PAYMENT_NUMBER=01XXXXXXXXX

# Must start with https:// (e.g. your Payment Proof Group invite link)
PAYMENT_PROOF_LINK=https://t.me/your_proof_group

# Path of the SQLite file. Point this at a persistent volume in production.
DB_PATH=/data/khan_auto_reply.db

# Optional: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
